local function OptimizePart(part)
    if part:IsA("BasePart") then
        part.Material = Enum.Material.SmoothPlastic
        part.Reflectance = 0
        part.CastShadow = false
        part.Color = Color3.fromRGB(100, 100, 105)
    elseif part:IsA("MeshPart") then
        part.Material = Enum.Material.SmoothPlastic
        part.Reflectance = 0
        part.TextureID = "" -- Nuke texture của Mesh
        part.Color = Color3.fromRGB(100, 100, 105)
    elseif part:IsA("Decal") or part:IsA("Texture") or part:IsA("ParticleEmitter") or part:IsA("Trail") or part:IsA("Fire") or part:IsA("Smoke") or part:IsA("Sparkles") or part:IsA("Beam") then
        part:Destroy() -- Xóa vĩnh viễn các hạt hiệu ứng chiêu thức/trái ác quỷ
    end
end

