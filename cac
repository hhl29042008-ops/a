--!nonstrict
-- Standalone FPS boost reconstructed from the active client state.
-- One-shot by design: no Heartbeat/RenderStepped/DescendantAdded listener.

if not game:IsLoaded() then
    game.Loaded:Wait()
end

local ENV = (getgenv and getgenv()) or _G
local STATE_KEY = "ClientFPSBoost"
local SCAN_BATCH_SIZE = 300
local SCAN_PAUSE_SECONDS = 0.03

local previous = ENV[STATE_KEY]
if type(previous) == "table" and type(previous.Cancel) == "function" then
    pcall(previous.Cancel, previous, "re-executed")
end

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local State = {
    Active = true,
    Running = false,
    Done = false,
    Reason = nil,
    Stats = {
        Scanned = 0,
        Changed = 0,
        Destroyed = 0,
        Errors = 0,
    },
}
ENV[STATE_KEY] = State

local function safeSet(instance, property, value)
    local ok = pcall(function()
        instance[property] = value
    end)
    if not ok then
        State.Stats.Errors = State.Stats.Errors + 1
    end
    return ok
end

local function safeDestroy(instance)
    local ok = pcall(instance.Destroy, instance)
    if ok then
        State.Stats.Destroyed = State.Stats.Destroyed + 1
    else
        State.Stats.Errors = State.Stats.Errors + 1
    end
    return ok
end

local function applyGlobalSettings()
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)
    pcall(function()
        settings().Rendering.EditQualityLevel = Enum.QualityLevel.Level01
    end)

    pcall(function()
        if sethiddenproperty then
            sethiddenproperty(Lighting, "Technology", Enum.Technology.Compatibility)
        end
    end)

    safeSet(Lighting, "GlobalShadows", false)
    safeSet(Lighting, "Brightness", -1)
    safeSet(Lighting, "EnvironmentDiffuseScale", 0)
    safeSet(Lighting, "EnvironmentSpecularScale", 0)
    safeSet(Lighting, "ExposureCompensation", 0)
    safeSet(Lighting, "FogStart", 9e9)
    safeSet(Lighting, "FogEnd", 9e9)
    safeSet(Lighting, "ShadowSoftness", 0)
    safeSet(Workspace, "GlobalWind", Vector3.zero)

    local Terrain = Workspace:FindFirstChildOfClass("Terrain")
    if Terrain then
        safeSet(Terrain, "WaterWaveSize", 0)
        safeSet(Terrain, "WaterWaveSpeed", 0)
        safeSet(Terrain, "WaterReflectance", 0)
        safeSet(Terrain, "WaterTransparency", 1)
    end
end

local disableEnabledClasses = {
    ParticleEmitter = true,
    Trail = true,
    Beam = true,
    Fire = true,
    Smoke = true,
    Sparkles = true,
    PointLight = true,
    SpotLight = true,
    SurfaceLight = true,
    Highlight = true,
    SelectionBox = true,
}

local destroyClasses = {
    Atmosphere = true,
    BloomEffect = true,
    BlurEffect = true,
    Clouds = true,
    ColorCorrectionEffect = true,
    DepthOfFieldEffect = true,
    SunRaysEffect = true,
    SurfaceAppearance = true,
}

local function optimizeInstance(instance)
    if not State.Active or not instance or not instance.Parent then
        return
    end

    State.Stats.Scanned = State.Stats.Scanned + 1
    local className = instance.ClassName
    local changed = false

    if instance:IsA("BasePart") then
        changed = safeSet(instance, "Material", Enum.Material.SmoothPlastic) or changed
        changed = safeSet(instance, "Reflectance", 0) or changed
        changed = safeSet(instance, "CastShadow", false) or changed

        if className == "MeshPart" then
            changed = safeSet(instance, "TextureID", "") or changed
        end
    elseif className == "SpecialMesh" then
        changed = safeSet(instance, "TextureId", "") or changed
    elseif disableEnabledClasses[className] then
        -- The live boost disables these without zeroing particle Rate/Lifetime
        -- or Beam width/texture, so gameplay attachments remain structurally intact.
        changed = safeSet(instance, "Enabled", false) or changed
    elseif destroyClasses[className] then
        safeDestroy(instance)
        return
    elseif className == "Sky" and instance:IsDescendantOf(Lighting) then
        safeDestroy(instance)
        return
    elseif className == "Explosion" then
        changed = safeSet(instance, "Visible", false) or changed
    end

    if changed then
        State.Stats.Changed = State.Stats.Changed + 1
    end
end

function State:Cancel(reason)
    self.Active = false
    self.Running = false
    self.Reason = reason or "cancelled"
end

function State:Apply()
    if self.Running then
        return false
    end

    self.Active = true
    self.Running = true
    self.Done = false
    self.Reason = nil
    applyGlobalSettings()

    task.spawn(function()
        local ok, descendants = pcall(game.GetDescendants, game)
        if not ok then
            self.Stats.Errors = self.Stats.Errors + 1
            self.Running = false
            self.Reason = tostring(descendants)
            warn("[ClientFPSBoost] Unable to scan DataModel: " .. tostring(descendants))
            return
        end

        local batchCount = 0
        for index = 1, #descendants do
            if not self.Active or ENV[STATE_KEY] ~= self then
                self.Running = false
                return
            end

            local optimized = pcall(optimizeInstance, descendants[index])
            if not optimized then
                self.Stats.Errors = self.Stats.Errors + 1
            end
            batchCount = batchCount + 1
            if batchCount >= SCAN_BATCH_SIZE then
                batchCount = 0
                task.wait(SCAN_PAUSE_SECONDS)
            end
        end

        self.Running = false
        self.Done = true
        print(string.format(
            "[ClientFPSBoost] Done | scanned=%d changed=%d destroyed=%d errors=%d cap=%d",
            self.Stats.Scanned,
            self.Stats.Changed,
            self.Stats.Destroyed,
            self.Stats.Errors
        ))
    end)

    return true
end

State:Apply()
return State
