-- UltraLight FPS Boost - low-CPU visible/farm-safe edition
-- Preserves farm dependencies plus the native Quest/Beli/Level/Health/Energy
-- HUD while removing other client-only render/audio work across the DataModel.

local ENV = (getgenv and getgenv()) or _G
local GLOBAL = _G
local VERSION = 6

-- Stop an older version and disconnect its legacy public connection.
local previous = ENV.UltraLightFPSBoost or GLOBAL.UltraLightFPSBoost
if type(previous) == "table" and type(previous.Stop) == "function" then
    pcall(previous.Stop, false)
end
for _, environment in ipairs({ ENV, GLOBAL }) do
    if environment.FPSBConn then
        pcall(function()
            environment.FPSBConn:Disconnect()
        end)
    end
end

local Services = setmetatable({}, {
    __index = function(self, name)
        local ok, service = pcall(game.GetService, game, name)
        if ok then
            rawset(self, name, service)
            return service
        end
    end,
})

local Workspace = Services.Workspace
local Lighting = Services.Lighting
local RunService = Services.RunService
local Players = Services.Players
local SoundService = Services.SoundService
local CoreGui = Services.CoreGui
local LocalPlayer = Players and Players.LocalPlayer

local Stats = {
    scanned = 0,
    destroyed = 0,
    disabled = 0,
    errors = 0,
}
local Processed = setmetatable({}, { __mode = "k" })
local Connections = {}
local State = {
    Active = true,
    Version = VERSION,
    Stats = Stats,
    Connections = Connections,
}

ENV.FPSB = true
ENV.NR = false
ENV.UltraLightFPSBoost = State
GLOBAL.FPSB = true
GLOBAL.NR = false
GLOBAL.UltraLightFPSBoost = State

-- Keep only these branches from PlayerGui.Main. Matching is case-insensitive;
-- aliases cover small UI-name differences between Blox Fruits versions.
local allowedMainHudNames = {
    quest = true,
    beli = true,
    money = true,
    cash = true,
    level = true,
    lvl = true,
    health = true,
    hp = true,
    energy = true,
    stamina = true,
}

local neutralize

local function isAllowedMainHudName(name)
    local normalized = string.lower(name):gsub("[%s_%-]", "")
    return allowedMainHudNames[normalized] == true
end

-- Existing instances of these classes are safe to delete only in active render
-- containers and only when they do not belong to a Humanoid model or Tool.
local disposableVisualClasses = {
    Atmosphere = true,
    Beam = true,
    BloomEffect = true,
    BlurEffect = true,
    Clouds = true,
    ColorCorrectionEffect = true,
    Decal = true,
    DepthOfFieldEffect = true,
    Fire = true,
    Highlight = true,
    ParticleEmitter = true,
    SelectionBox = true,
    Smoke = true,
    Sparkles = true,
    SunRaysEffect = true,
    SurfaceAppearance = true,
    Texture = true,
    Trail = true,
}

local function isInside(root, instance)
    return root and instance ~= root and instance:IsDescendantOf(root)
end

local function belongsToActorOrTool(instance)
    if instance:FindFirstAncestorWhichIsA("Tool") then
        return true
    end

    local parent = instance.Parent
    while parent and parent ~= Workspace do
        if parent:IsA("Model") and parent:FindFirstChildOfClass("Humanoid") then
            return true
        end
        parent = parent.Parent
    end

    return false
end

local function canDestroyVisual(instance, className, destructivePass)
    if not destructivePass or not disposableVisualClasses[className] then
        return false
    end
    if not (isInside(Workspace, instance) or isInside(Lighting, instance)) then
        return false
    end
    return not belongsToActorOrTool(instance)
end

local function disableEnabled(instance)
    instance.Enabled = false
end

local function disableParticle(instance)
    instance.Enabled = false
    instance.Rate = 0
    instance.Lifetime = NumberRange.new(0)
end

local function disableTrail(instance)
    instance.Enabled = false
    instance.Lifetime = 0
end

local function disableBeam(instance)
    instance.Enabled = false
    instance.Texture = ""
    instance.Width0 = 0
    instance.Width1 = 0
end

local function disableAtmosphere(instance)
    instance.Density = 0
    instance.Glare = 0
    instance.Haze = 0
end

local function disableClouds(instance)
    instance.Enabled = false
    instance.Cover = 0
    instance.Density = 0
end

local function simplifySky(instance)
    -- Keep the background so the client never becomes a black/white screen.
    instance.CelestialBodiesShown = false
    instance.StarCount = 0
end

local function disableLight(instance)
    instance.Enabled = false
    instance.Brightness = 0
    instance.Shadows = false
end

local function hideAdornment(instance)
    instance.Enabled = false
end

local function hideExplosion(instance)
    instance.Visible = false
end

local function hideTexture(instance)
    instance.Transparency = 1
end

local function stripSurfaceAppearance(instance)
    instance.ColorMap = ""
    instance.MetalnessMap = ""
    instance.NormalMap = ""
    instance.RoughnessMap = ""
    instance.AlphaMode = Enum.AlphaMode.Overlay
end

local function hideBasePart(instance)
    -- This does not change Transparency/collision/touch/query/CFrame values used
    -- by the game and farm.
    instance.LocalTransparencyModifier = 1
    instance.CastShadow = false
    instance.Reflectance = 0
end

local function hideMeshPart(instance)
    hideBasePart(instance)
    instance.TextureID = ""
    instance.RenderFidelity = Enum.RenderFidelity.Performance
end

local function hideUnion(instance)
    hideBasePart(instance)
    instance.RenderFidelity = Enum.RenderFidelity.Performance
end

local function stripSpecialMesh(instance)
    instance.TextureId = ""
end

local function hideForceField(instance)
    instance.Visible = false
end

local function disableWorldGui(instance)
    instance.Enabled = false
end



local function disableVideo(instance)
    instance.Playing = false
    instance.Volume = 0
    instance.Visible = false
end

local function hideViewport(instance)
    instance.Visible = false
end

local function muteSound(instance)
    instance.Volume = 0
    instance.Looped = false
    instance:Stop()
end

local function muteSoundGroup(instance)
    instance.Volume = 0
end

-- Direct ClassName dispatch avoids a long IsA chain for every Folder, Model,
-- attachment and UI object created while farming.
local classHandlers = {
    ParticleEmitter = disableParticle,
    Trail = disableTrail,
    Beam = disableBeam,
    Fire = disableEnabled,
    Smoke = disableEnabled,
    Sparkles = disableEnabled,
    BloomEffect = disableEnabled,
    BlurEffect = disableEnabled,
    ColorCorrectionEffect = disableEnabled,
    DepthOfFieldEffect = disableEnabled,
    SunRaysEffect = disableEnabled,
    Atmosphere = disableAtmosphere,
    Clouds = disableClouds,
    Sky = simplifySky,
    PointLight = disableLight,
    SpotLight = disableLight,
    SurfaceLight = disableLight,
    Highlight = hideAdornment,
    SelectionBox = hideAdornment,
    Explosion = hideExplosion,
    Decal = hideTexture,
    Texture = hideTexture,
    SurfaceAppearance = stripSurfaceAppearance,
    Part = hideBasePart,
    WedgePart = hideBasePart,
    CornerWedgePart = hideBasePart,
    TrussPart = hideBasePart,
    Seat = hideBasePart,
    VehicleSeat = hideBasePart,
    SpawnLocation = hideBasePart,
    MeshPart = hideMeshPart,
    UnionOperation = hideUnion,
    SpecialMesh = stripSpecialMesh,
    ForceField = hideForceField,
    VideoFrame = disableVideo,
    ViewportFrame = hideViewport,
    Sound = muteSound,
    SoundGroup = muteSoundGroup,
}

-- Common non-render objects can return immediately without any IsA call.
local ignoredClasses = {
    Accessory = true,
    Animation = true,
    Animator = true,
    Attachment = true,
    BindableEvent = true,
    BindableFunction = true,
    BoolValue = true,
    Camera = true,
    CFrameValue = true,
    ClickDetector = true,
    Configuration = true,
    Folder = true,
    Frame = true,
    Humanoid = true,
    ImageButton = true,
    ImageLabel = true,
    IntValue = true,
    LocalScript = true,
    Model = true,
    ModuleScript = true,
    Motor6D = true,
    NumberValue = true,
    ObjectValue = true,
    ProximityPrompt = true,
    RemoteEvent = true,
    RemoteFunction = true,
    Script = true,
    StringValue = true,
    TextButton = true,
    TextLabel = true,
    TextBox = true,
    Tool = true,
    UICorner = true,
    UIGradient = true,
    UIListLayout = true,
