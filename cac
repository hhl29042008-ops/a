local G = (getgenv and getgenv()) or _G
local old = G.UltraLightFpsBoost
if old then
    old.Active = false
    for _, c in ipairs(old.Connections) do pcall(function() c:Disconnect() end) end
end

local state = {Active = true, Connections = {}}
G.UltraLightFpsBoost = state

local RunService = game:GetService("RunService")
pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
pcall(function() game:GetService("SoundService").Volume = 0 end)
pcall(function() game:GetService("SoundService").AmbientReverb = Enum.ReverbType.NoReverb end)

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local gray = Color3.fromRGB(112, 112, 112)
local changed = 0

local function reduce(v)
    if v:IsA("BasePart") then
        v.CastShadow, v.Reflectance, v.Material, v.Color, v.LocalTransparencyModifier = false, 0, Enum.Material.SmoothPlastic, gray, 1
        if v:IsA("MeshPart") then v.TextureID = "" end
    elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then
        v.Enabled = false
        v:Clear()
    elseif v:IsA("Beam") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Light") or v:IsA("Highlight") or v:IsA("BillboardGui") or v:IsA("SurfaceGui") then
        v.Enabled = false
    elseif v:IsA("PostEffect") then
        if v.Name ~= "UltraLightGray" then v.Enabled = false end
    elseif v:IsA("Decal") or v:IsA("Texture") then
        v.Transparency = 1
    elseif v:IsA("SpecialMesh") then
        v.TextureId = ""
    elseif v:IsA("SurfaceAppearance") then
        v.ColorMap, v.MetalnessMap, v.NormalMap, v.RoughnessMap = "", "", "", ""
    elseif v:IsA("Atmosphere") then
        v.Density, v.Haze, v.Glare = 0, 0, 0
    elseif v:IsA("Clouds") then
        v.Coverage, v.Density = 0, 0
    elseif v:IsA("Sky") then
        v.CelestialBodiesShown, v.StarCount, v.SkyboxBk, v.SkyboxDn, v.SkyboxFt, v.SkyboxLf, v.SkyboxRt, v.SkyboxUp, v.SunTextureId, v.MoonTextureId = false, 0, "", "", "", "", "", "", "", ""
    elseif v:IsA("Sound") then
        v.Volume = 0
    else
        return
    end
    changed += 1
end

Lighting.GlobalShadows = false
Lighting.EnvironmentDiffuseScale, Lighting.EnvironmentSpecularScale = 0, 0
Lighting.Ambient, Lighting.OutdoorAmbient = gray, gray
Lighting.ColorShift_Bottom, Lighting.ColorShift_Top = Color3.new(), Color3.new()
pcall(function() Lighting.Technology = Enum.Technology.Compatibility end)

local tone = Lighting:FindFirstChild("UltraLightGray") or Instance.new("ColorCorrectionEffect")
tone.Name, tone.Saturation, tone.Contrast, tone.Brightness, tone.TintColor = "UltraLightGray", -1, 0, 0, Color3.new(1, 1, 1)
tone.Parent = Lighting

local terrain = Workspace:FindFirstChildOfClass("Terrain")
if terrain then
    terrain.WaterWaveSize, terrain.WaterWaveSpeed, terrain.WaterReflectance = 0, 0, 0
    for _, material in ipairs(Enum.Material:GetEnumItems()) do pcall(terrain.SetMaterialColor, terrain, material, gray) end
end

for i, v in ipairs(Workspace:GetDescendants()) do
    pcall(reduce, v)
    if i % 800 == 0 then task.wait() end
end
for _, v in ipairs(Lighting:GetDescendants()) do pcall(reduce, v) end

state.Connections[1] = Workspace.DescendantAdded:Connect(function(v)
    if state.Active then pcall(reduce, v) end
end)
tone.Enabled = true
G.UltraLightFpsBoostStats = {Active = true, Applied = changed}
