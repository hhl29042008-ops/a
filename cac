if _G.FPSB then return end _G.FPSB = true
local S = setmetatable({}, {__index = function(s, n) local ok, c = pcall(game.GetService, game, n) if ok then rawset(s, n, c) return c end end})
local LP = S.Players.LocalPlayer

_G.NR = true
S.RunService:Set3dRenderingEnabled(not _G.NR)

S.Lighting.GlobalShadows = false S.Lighting.FogEnd = 9e9 S.Lighting.FogStart = 9e9 S.Lighting.Brightness = 1
S.Lighting.ClockTime = 14 S.Lighting.EnvironmentDiffuseScale = 0 S.Lighting.EnvironmentSpecularScale = 0
pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
pcall(function() sethiddenproperty(S.Lighting, "Technology", 2) end)
pcall(function() local t = workspace.Terrain t.WaterWaveSize = 0 t.WaterWaveSpeed = 0 t.WaterReflectance = 0 t.WaterTransparency = 0 t.Decoration = false end)

for _, v in next, S.Lighting:GetDescendants() do pcall(function()
    if v:IsA("Sky") then v.SkyboxBk = "" v.SkyboxDn = "" v.SkyboxFt = "" v.SkyboxLf = "" v.SkyboxRt = "" v.SkyboxUp = "" v.StarCount = 0 v.MoonSize = 0 v.SunAngularSize = 0
    elseif v:IsA("Atmosphere") then v.Density = 0 v.Glare = 0 v.Haze = 0
    elseif v:IsA("Clouds") then v.Enabled = false
    elseif v:IsA("PostEffect") then v.Enabled = false end
end) end

local function isNPC(p) local m = p:FindFirstAncestorWhichIsA("Model") return m and (m:FindFirstChildOfClass("Humanoid") or m.Name == "Characters" or m.Name == "Enemies" or m.Name == "NPCs") end
local function isChr(p) for _, pl in next, S.Players:GetPlayers() do if pl.Character and p:IsDescendantOf(pl.Character) then return true end end return false end

local function opt(v)
    if not v or not v.Parent then return end
    pcall(function()
        if v:IsA("Humanoid") or v:IsA("ProximityPrompt") or v:IsA("ClickDetector") or v:IsA("Camera")
           or v:IsA("SpawnLocation") or v:IsA("Tool") or v:IsA("BaseScript") or v:IsA("RemoteEvent")
           or v:IsA("RemoteFunction") or v:IsA("BillboardGui") or v:IsA("ScreenGui") or v:IsA("SurfaceGui") then return end
        if isChr(v) then return end

        if v:IsA("ParticleEmitter") then v.Enabled = false v.Rate = 0 v.Lifetime = NumberRange.new(0, 0) return end
        if v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") or v:IsA("Trail") or v:IsA("Beam") then v.Enabled = false return end
        if v:IsA("Highlight") or v:IsA("SelectionBox") then v.Enabled = false return end
        if v:IsA("Explosion") then v.Visible = false return end
        if v:IsA("Light") then v.Enabled = false return end
        if v:IsA("Decal") or v:IsA("Texture") then v.Transparency = 1 return end
        if v:IsA("Sound") then local n = v.Name:lower() if n:find("ambient") or n:find("music") or n:find("wind") or n:find("water") or n:find("bgm") or n:find("background") or n:find("ocean") or n:find("rain") then v.Volume = 0 v.Playing = false end return end
        
        if v:IsA("BasePart") then
            local isFX = v:FindFirstAncestor("FX") or v:FindFirstAncestor("Effects") or v:FindFirstAncestor("Debris")
            if (not isFX) and (isNPC(v) or v.Name == "HumanoidRootPart" or v.Name == "Head") then return end
            v.Transparency = 1 v.CastShadow = false v.Reflectance = 0 v.Material = Enum.Material.SmoothPlastic
            if v:IsA("MeshPart") then pcall(function() v.TextureID = "" v.RenderFidelity = Enum.RenderFidelity.Performance end) end
        end
    end)
end

local d = workspace:GetDescendants() for i = 1, #d do opt(d[i]) if i % 300 == 0 then task.wait() end end
for _, v in next, S.ReplicatedStorage:GetDescendants() do pcall(function() if v:IsA("ParticleEmitter") then v.Enabled = false v.Rate = 0 v.Lifetime = NumberRange.new(0,0) elseif v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") or v:IsA("Trail") or v:IsA("Beam") then v.Enabled = false end end) end

if _G.FPSBConn then pcall(function() _G.FPSBConn:Disconnect() end) end
_G.FPSBConn = workspace.DescendantAdded:Connect(function(v) task.defer(opt, v) end)
