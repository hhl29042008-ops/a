-- Cache inheritance fallback once per uncommon ClassName. A private sentinel is
-- used because nil cannot be stored as a cached "not visual" result.
local NO_HANDLER = {}
local fallbackClassHandlers = {}

local function resolveFallbackHandler(instance, className)
    local cached = fallbackClassHandlers[className]
    if cached ~= nil then
        return cached ~= NO_HANDLER and cached or nil
    end

    local ok, handler = pcall(function()
        if instance:IsA("BasePart") then
            return hideBasePart
        elseif instance:IsA("PostEffect") then
            return disableEnabled
        elseif instance:IsA("Light") then
            return disableLight
        end
    end)

    if not ok then
        Stats.errors = Stats.errors + 1
        return nil
    end

    fallbackClassHandlers[className] = handler or NO_HANDLER
    return handler
end

neutralize = function(instance, destructivePass)
    if not State.Active or not instance or not instance.Parent or Processed[instance] then
        return
    end

    local className = instance.ClassName
    local handler = classHandlers[className]
    if not handler then
        -- Hot path: common gameplay/data objects skip weak-table writes, stats,
        -- pcall and inheritance checks entirely.
        if ignoredClasses[className] then
            return
        end

        handler = resolveFallbackHandler(instance, className)
        if not handler then
            return
        end
    end

    Processed[instance] = true
    Stats.scanned = Stats.scanned + 1

    local action = 0
    local ok = pcall(function()
        if canDestroyVisual(instance, className, destructivePass) then
            instance:Destroy()
            action = 2
            return
        end

        handler(instance)
        action = 1
    end)

    if not ok then
        Stats.errors = Stats.errors + 1
        Processed[instance] = nil -- allow a later reparent/scan to retry
    elseif action == 2 then
        Stats.destroyed = Stats.destroyed + 1
    elseif action == 1 then
        Stats.disabled = Stats.disabled + 1
    end
end

local function safeSet(instance, property, value)
    pcall(function()
        instance[property] = value
    end)
end

local function applyGlobalSettings()
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)
    pcall(function()
        settings().Rendering.EditQualityLevel = Enum.QualityLevel.Level01
    end)
    pcall(function()
        if sethiddenproperty then
            sethiddenproperty(Lighting, "Technology", Enum.Technology.Compatibility)
        end
    end)

    safeSet(Lighting, "GlobalShadows", false)
    safeSet(Lighting, "Brightness", 1)
    safeSet(Lighting, "EnvironmentDiffuseScale", 0)
    safeSet(Lighting, "EnvironmentSpecularScale", 0)
    safeSet(Lighting, "ExposureCompensation", 0)
    safeSet(Lighting, "FogStart", 9e9)
    safeSet(Lighting, "FogEnd", 9e9)
    safeSet(Lighting, "ShadowSoftness", 0)

    local terrain = Workspace.Terrain
    safeSet(terrain, "WaterWaveSize", 0)
    safeSet(terrain, "WaterWaveSpeed", 0)
    safeSet(terrain, "WaterReflectance", 0)
    safeSet(terrain, "WaterTransparency", 1)
    safeSet(terrain, "Decoration", false)
    safeSet(Workspace, "GlobalWind", Vector3.new(0, 0, 0))

    safeSet(SoundService, "AmbientReverb", Enum.ReverbType.NoReverb)
    safeSet(SoundService, "DopplerScale", 0)
end

local function track(signal, callback)
    local connection = signal:Connect(callback)
    Connections[#Connections + 1] = connection
    return connection
end

function State.Stop(restore3D)
    State.Active = false
    for index = #Connections, 1, -1 do
        pcall(function()
            Connections[index]:Disconnect()
        end)
        Connections[index] = nil
    end

    if ENV.UltraLightFPSBoost == State then
        ENV.FPSBConn = nil
        ENV.FPSB = false
        ENV.UltraLightFPSBoost = nil
    end
    if GLOBAL.UltraLightFPSBoost == State then
        GLOBAL.FPSBConn = nil
        GLOBAL.FPSB = false
        GLOBAL.UltraLightFPSBoost = nil
    end

end

applyGlobalSettings()

-- Prevent the farm's optional +/-infinite exposure from making the client
-- black or white. Event-driven: no Heartbeat/RenderStepped loop.
State.ExposureConnection = track(
    Lighting:GetPropertyChangedSignal("ExposureCompensation"),
    function()
        if State.Active and Lighting.ExposureCompensation ~= 0 then
            safeSet(Lighting, "ExposureCompensation", 0)
        end
    end
)

local function scanChildren(root)
    if not root or not State.Active then
        return
    end

    local ok, children = pcall(root.GetChildren, root)
    if not ok then
        Stats.errors = Stats.errors + 1
        return
    end

    for index = 1, #children do
        neutralize(children[index], false)
    end
end


-- Listen only where client render/audio work can actually become active. The
-- old DataModel-wide listener also ran for every Remote, Value and replicated
-- asset created anywhere in the game, which caused unnecessary CPU usage.
State.WorkspaceConnection = track(Workspace.DescendantAdded, function(instance)
    neutralize(instance, false)
end)
State.Connection = State.WorkspaceConnection -- compatibility with old loaders
ENV.FPSBConn = State.Connection
GLOBAL.FPSBConn = State.Connection

State.LightingConnection = track(Lighting.DescendantAdded, function(instance)
    neutralize(instance, false)
end)
State.SoundConnection = track(SoundService.DescendantAdded, function(instance)
    neutralize(instance, false)
end)



-- The initial pass is limited to active render/audio containers. Replicated
-- assets are handled later when they enter one of these roots. A small timed
-- yield caps startup CPU instead of monopolizing consecutive scheduler slices.
local SCAN_BATCH_SIZE = 200
local SCAN_PAUSE_SECONDS = 0.03

local function scanDescendants(root, destructivePass)
    if not root or not State.Active then
        return
    end

    local ok, descendants = pcall(root.GetDescendants, root)
    if not ok then
        Stats.errors = Stats.errors + 1
        return
    end

    local batchCount = 0
    for index = 1, #descendants do
        if not State.Active then
            return
        end

        neutralize(descendants[index], destructivePass)
        batchCount = batchCount + 1
        if batchCount >= SCAN_BATCH_SIZE then
            batchCount = 0
            task.wait(SCAN_PAUSE_SECONDS)
        end
    end
end

task.spawn(function()
    scanDescendants(Workspace, true)
    task.wait(SCAN_PAUSE_SECONDS)
    scanDescendants(Lighting, true)
    task.wait(SCAN_PAUSE_SECONDS)
    scanDescendants(SoundService, false)
end)

