task.spawn(function()
  local a = os.clock()
  repeat wait(1) until getgenv().ScriptLoaded or os.clock() - a >= 240
  if not getgenv().ScriptLoaded then
    while true do
      pcall(function() game:GetService("TeleportService"):TeleportReconnect()end)
      task.wait(5)
    end
  end
end)
